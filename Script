-- Função para criar botão toggle
local function createToggle(name, order)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Size = UDim2.new(1, 0, 0, 46)
    btn.BackgroundColor3 = CONFIG.Colors.Off
    btn.Text = name .. "  [OFF]"
    btn.TextColor3 = CONFIG.Colors.Text
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 15
    btn.AutoButtonColor = false
    btn.LayoutOrder = order
    btn.ZIndex = 12
    btn.Parent = Body

    local c = Instance.new("UICorner") c.CornerRadius = UDim.new(0, 10) c.Parent = btn
    local s = Instance.new("UIStroke") s.Color = CONFIG.Colors.Border s.Thickness = 1 s.Parent = btn

    local ind = Instance.new("Frame")
    ind.Size = UDim2.fromOffset(6, 24)
    ind.Position = UDim2.new(0, 0, 0.5, -12)
    ind.BackgroundColor3 = CONFIG.Colors.Accent
    ind.BorderSizePixel = 0
    ind.ZIndex = 13
    ind.Parent = btn
    local ic = Instance.new("UICorner") ic.CornerRadius = UDim.new(1, 0) ic.Parent = ind

    return btn
end

