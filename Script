-- Arrastar janela
dragButton.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		draggingWindow = true
		dragStart = input.Position
		startPos = window.Position
	end
end)

-- Resize
resizeHandle.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		resizing = true
		resizeStart = input.Position
		sizeStart = window.Size
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		if draggingSpeed then updateSpeedSlider(input.Position.X) end
		if draggingJump then updateJumpSlider(input.Position.X) end
		if draggingWindow then
			local delta = input.Position - dragStart
			window.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
		if resizing then
			local delta = input.Position - resizeStart
			local newW = math.clamp(sizeStart.X.Offset + delta.X, 280, 550)
			local newH = math.clamp(sizeStart.Y.Offset + delta.Y, 300, 500)
			window.Size = UDim2.new(0, newW, 0, newH)
		end
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		draggingSpeed = false
		draggingJump = false
		draggingWindow = false
		resizing = false
	end
end)

