        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 53,
    })

    local TabContent = Create("ScrollingFrame", {
        Parent = Content,
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 4,
        ScrollBarImageColor3 = CONFIG.Green,
        ScrollBarImageTransparency = 0.2,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
        ZIndex = 52,
    })

    Create("UIListLayout", {
        Parent = TabContent,
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
    })

    Create("UIPadding", {
        Parent = TabContent,
        PaddingTop = UDim.new(0, 10),
        PaddingBottom = UDim.new(0, 20),
        PaddingLeft = UDim.new(0, 10),
        PaddingRight = UDim.new(0, 10),
    })

    local tab = {
        Button = TabBtn,
        Label = TabLabel,
        Content = TabContent,
        Indicator = Indicator,
        Name = name,
    }
    Tabs[name] = tab

    TabBtn.MouseEnter:Connect(function()
        if State.ActiveTab ~= name then
            TweenService:Create(TabBtn, TweenInfo.new(0.15), {
                BackgroundColor3 = CONFIG.BgHover,
            }):Play()
        end
    end)

    TabBtn.MouseLeave:Connect(function()
        if State.ActiveTab ~= name then
            TweenService:Create(TabBtn, TweenInfo.new(0.15), {
                BackgroundColor3 = CONFIG.BgTertiary,
            }):Play()
        end
    end)

    TabBtn.MouseButton1Click:Connect(function()
        for _, t in pairs(Tabs) do
            t.Content.Visible = false
            t.Indicator.Visible = false
            TweenService:Create(t.Button, TweenInfo.new(0.2), {
                BackgroundColor3 = CONFIG.BgTertiary,
            }):Play()
            TweenService:Create(t.Label, TweenInfo.new(0.2), {
                TextColor3 = CONFIG.Text,
            }):Play()
        end

        TabContent.Visible = true
        Indicator.Visible = true

        TweenService:Create(TabBtn, TweenInfo.new(0.2), {
            BackgroundColor3 = CONFIG.BgHover,
        }):Play()
        TweenService:Create(TabLabel, TweenInfo.new(0.2), {
            TextColor3 = CONFIG.Green,
        }):Play()

        State.ActiveTab = name
    end)

    return tab
end

