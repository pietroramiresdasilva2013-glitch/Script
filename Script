-- Variáveis
local currentSpeed = 16
local currentJump = 50
local maxSpeed = 120
local maxJump = 200
local draggingSpeed = false
local draggingJump = false
local resizing = false
local draggingWindow = false
local aberto = false
local dragStart, startPos, resizeStart, sizeStart

local function applySpeed(value)
	currentSpeed = math.clamp(math.floor(value + 0.5), 1, maxSpeed)
	speedLabel.Text = "Velocidade: " .. currentSpeed
	local percent = currentSpeed / maxSpeed
	speedFill.Size = UDim2.new(percent, 0, 1, 0)
	speedBtn.Position = UDim2.new(percent, -10, 0.5, -10)

	local char = player.Character
	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.WalkSpeed = currentSpeed
		end
	end
end

local function applyJump(value)
	currentJump = math.clamp(math.floor(value + 0.5), 1, maxJump)
	jumpLabel.Text = "Pulo: " .. currentJump
	local percent = currentJump / maxJump
	jumpFill.Size = UDim2.new(percent, 0, 1, 0)
	jumpBtn.Position = UDim2.new(percent, -10, 0.5, -10)

	local char = player.Character
	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.JumpPower = currentJump
			hum.UseJumpPower = true
		end
	end
end

local function updateSpeedSlider(x)
	local absPos = speedSliderBg.AbsolutePosition.X
	local absSize = speedSliderBg.AbsoluteSize.X
	local relative = math.clamp((x - absPos) / absSize, 0, 1)
	applySpeed(relative * maxSpeed)
end

local function updateJumpSlider(x)
	local absPos = jumpSliderBg.AbsolutePosition.X
	local absSize = jumpSliderBg.AbsoluteSize.X
	local relative = math.clamp((x - absPos) / absSize, 0, 1)
	applyJump(relative * maxJump)
end

