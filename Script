local function CreateToggle(tab, text, default, callback)
    local Container = Create("Frame", {
        Parent = tab.Content,
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundColor3 = CONFIG.BgTertiary,
        BorderSizePixel = 0,
    })
    Corner(Container, 8)
    Stroke(Container, CONFIG.Green, 1, 0.6)

    Create("TextLabel", {
        Parent = Container,
        Size = UDim2.new(1, -80, 1, 0),
        Position = UDim2.new(0, 12, 0, 0),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = CONFIG.Text,
        Font = CONFIG.FontSemi,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    local Switch = Create("TextButton", {
        Parent = Container,
        Size = UDim2.new(0, 44, 0, 20),
        Position = UDim2.new(1, -56, 0.5, -10),
        BackgroundColor3 = Color3.fromRGB(60, 70, 65),
        Text = "",
        AutoButtonColor = false,
    })
    Corner(Switch, 10)

    local Knob = Create("Frame", {
        Parent = Switch,
        Size = UDim2.new(0, 16, 0, 16),
        Position = UDim2.new(0, 2, 0.5, -8),
        BackgroundColor3 = CONFIG.Text,
        BorderSizePixel = 0,
    })
    Corner(Knob, 8)

    local enabled = default or false
    State.Toggles[text] = enabled
    State.Flags[text] = enabled

    local function SetState(newState, fire)
        enabled = newState
        State.Toggles[text] = newState
        State.Flags[text] = newState

        TweenService:Create(Switch, TweenInfo.new(0.22), {
            BackgroundColor3 = newState and CONFIG.GreenDark or Color3.fromRGB(60, 70, 65),
        }):Play()

        TweenService:Create(Knob, TweenInfo.new(0.22), {
            Position = newState and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8),
        }):Play()

        if fire and callback then
            task.spawn(function()
                pcall(callback, newState)
            end)
        end
    end

    Switch.MouseButton1Click:Connect(function()
        SetState(not enabled, true)
    end)

    SetState(enabled, false)
    return { Set = SetState, Get = function() return enabled end }
end
local function CreateSlider(tab, text, min, max, default, callback)
    local Container = Create("Frame", {
        Parent = tab.Content,
        Size = UDim2.new(1, 0, 0, 50),
        BackgroundColor3 = CONFIG.BgTertiary,
        BorderSizePixel = 0,
    })
    Corner(Container, 8)
    Stroke(Container, CONFIG.Green, 1, 0.6)

    local Label = Create("TextLabel", {
        Parent = Container,
        Size = UDim2.new(1, -20, 0, 20),
        Position = UDim2.new(0, 12, 0, 4),
        BackgroundTransparency = 1,
        Text = text .. ":  " .. tostring(default),
        TextColor3 = CONFIG.Text,
        Font = CONFIG.FontSemi,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    local BarBg = Create("Frame", {
        Parent = Container,
        Size = UDim2.new(1, -24, 0, 8),
        Position = UDim2.new(0, 12, 0, 32),
        BackgroundColor3 = Color3.fromRGB(60, 70, 65),
        BorderSizePixel = 0,
    })
    Corner(BarBg, 4)

    local BarFill = Create("Frame", {
        Parent = BarBg,
        Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = CONFIG.GreenDark,
        BorderSizePixel = 0,
    })
    Corner(BarFill, 4)

    local Dot = Create("Frame", {
        Parent = BarBg,
        Size = UDim2.new(0, 14, 0, 14),
        Position = UDim2.new((default - min) / (max - min), -7, 0.5, -7),
        BackgroundColor3 = CONFIG.Green,
        BorderSizePixel = 0,
        ZIndex = 2,
    })
    Corner(Dot, 7)

    local value = default
    local dragging = false

    local function SetValue(v, fire)
        value = math.clamp(math.floor(v * 100 + 0.5) / 100, min, max)
        local pct = (value - min) / (max - min)
        Label.Text = text .. ":  " .. tostring(value)

        TweenService:Create(BarFill, TweenInfo.new(0.1), {
            Size = UDim2.new(pct, 0, 1, 0),
        }):Play()
        TweenService:Create(Dot, TweenInfo.new(0.1), {
            Position = UDim2.new(pct, -7, 0.5, -7),
        }):Play()

        if fire and callback then pcall(callback, value) end
    end

    BarBg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local relX = input.Position.X - BarBg.AbsolutePosition.X
            local pct = math.clamp(relX / BarBg.AbsoluteSize.X, 0, 1)
            SetValue(min + (max - min) * pct, true)
        end
    end)

    return { Set = SetValue, Get = function() return value end }
end

